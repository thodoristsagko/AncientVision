# AncientVision API Keys
# Copy to .env and fill in your keys, then build with:
#   flutter run --dart-define=IMGBB_API_KEY=xxx --dart-define=NUMISTA_API_KEY=xxx ...
# Or use: scripts/build_with_keys.bat

IMGBB_API_KEY=your_imgbb_key_here
NUMISTA_API_KEY=your_numista_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENSCAN_USERNAME=openscan
OPENSCAN_PASSWORD=free
